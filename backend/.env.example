# Copy to backend/.env and adjust. All vars are prefixed VGET_.

# --- Auth (app login / who may use the service) ---
# DEV ONLY: skip Google login + allowlist so you can test downloads.
VGET_DEV_AUTH_BYPASS=true
# Comma-separated Google OAuth client IDs accepted as the token audience (aud).
VGET_GOOGLE_CLIENT_IDS=
# Comma-separated allowed Google account emails. Empty = allow any verified Google account.
VGET_ALLOWLIST=
# Secret for signing backend session JWTs. CHANGE in production.
VGET_JWT_SECRET=dev-insecure-change-me
VGET_JWT_TTL_SECONDS=3600

# --- CORS (web client origins) ---
# Comma-separated allowed origins, or * for dev.
VGET_CORS_ORIGINS=*

# --- Downloads ---
VGET_WORK_DIR=/tmp/vget
VGET_JOB_TTL_SECONDS=3600
VGET_MAX_FILESIZE_MB=2048
